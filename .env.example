# 이 파일을 복사해서 ".env" 로 저장하고 값을 채우세요.
#   PowerShell:  Copy-Item .env.example .env

# 디스코드 봇 토큰 (개발자 포털 > Bot > Reset Token)
DISCORD_TOKEN=

# Power Automate "HTTP 요청을 받은 경우" 트리거의 POST URL
POWER_AUTOMATE_URL=

# 봇<->Power Automate 공유 비밀키 (길고 무작위한 문자열 권장).
# Power Automate 흐름에서 동일 값으로 검증하면 외부인의 무단 호출을 막을 수 있음.
RELAY_SECRET=change-me-to-a-long-random-string

# 봇이 감지할 "공가제출" 채널 ID. 쉼표로 여러 개 가능.
# (디스코드 개발자 모드 ON → 채널 우클릭 → "채널 ID 복사")
# 비우면 이름에 "공가제출"이 들어간 채널을 자동 인식.
GONGA_CHANNEL_ID=

# (선택) 허용 최대 파일 크기(MB). 기본 20.
MAX_FILE_MB=20

# (선택) 과정 선택 후 파일 업로드를 기다리는 시간(초). 기본 120.
FILE_WAIT_SECONDS=120

# (선택) 저장 성공 후, 사용자가 올린 원본 파일 메시지를 삭제할지 여부.
# true 로 하려면 봇에게 "메시지 관리(Manage Messages)" 권한이 필요합니다.
DELETE_UPLOAD=false
